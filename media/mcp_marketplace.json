[
  {
    "id": "github",
    "name": "GitHub",
    "description": "GitHub 官方 MCP，建议使用 OAuth 或最小权限 PAT，按需限制仓库、Issue、PR、Actions 和安全相关工具集。",
    "homepage": "https://github.com/github/github-mcp-server",
    "category": "开发工具",
    "config": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "signupUrl": "https://docs.github.com/en/copilot/how-tos/provide-context/use-mcp-in-your-ide/set-up-the-github-mcp-server"
  },
  {
    "id": "microsoft-learn",
    "name": "Microsoft Learn",
    "description": "Microsoft Learn 官方 MCP，提供 Microsoft、Azure 和开发者文档检索与示例查询，通常无需私有凭据。",
    "homepage": "https://github.com/MicrosoftDocs/mcp",
    "category": "AI与智能",
    "config": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "signupUrl": "https://learn.microsoft.com/api/mcp"
  },
  {
    "id": "playwright",
    "name": "Playwright",
    "description": "Microsoft Playwright 官方 MCP，提供浏览器自动化、页面交互和测试调试能力；访问登录态或写操作前应由用户确认。",
    "homepage": "https://github.com/microsoft/playwright-mcp",
    "category": "网络与浏览器",
    "config": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "signupUrl": "https://playwright.dev/mcp/installation"
  },
  {
    "id": "docker-mcp-gateway",
    "name": "Docker MCP Gateway",
    "description": "Docker 官方 MCP Catalog 与 Gateway，用容器隔离、Profile、凭据和日志能力集中运行经验证 MCP 服务。",
    "homepage": "https://docs.docker.com/ai/mcp-catalog-and-toolkit/",
    "category": "基础设施",
    "config": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ]
    },
    "signupUrl": "https://docs.docker.com/ai/mcp-catalog-and-toolkit/mcp-gateway/"
  },
  {
    "id": "cloudflare-docs",
    "name": "Cloudflare Docs",
    "description": "Cloudflare 官方文档 MCP，用于检索 Cloudflare 产品文档和示例，优先作为低风险只读知识源使用。",
    "homepage": "https://github.com/cloudflare/mcp-server-cloudflare",
    "category": "网络与浏览器",
    "config": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "signupUrl": "https://developers.cloudflare.com/"
  },
  {
    "id": "cloudflare-browser",
    "name": "Cloudflare Browser Rendering",
    "description": "Cloudflare 官方 Browser Rendering MCP，连接 Cloudflare 浏览器渲染能力；访问站点和自动化操作前应确认权限边界。",
    "homepage": "https://github.com/cloudflare/mcp-server-cloudflare",
    "category": "网络与浏览器",
    "config": {
      "type": "http",
      "url": "https://browser.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "signupUrl": "https://developers.cloudflare.com/browser-rendering/"
  },
  {
    "id": "stripe",
    "name": "Stripe",
    "description": "Stripe 官方 MCP，支持文档和受限 API 操作；支付、退款、订阅等高风险写操作必须使用 restricted key 和人工确认。",
    "homepage": "https://docs.stripe.com/mcp",
    "category": "生产力工具",
    "config": {
      "type": "http",
      "url": "https://mcp.stripe.com",
      "headers": {
        "Authorization": "Bearer ${STRIPE_API_KEY}"
      }
    },
    "signupUrl": "https://dashboard.stripe.com/apikeys"
  },
  {
    "id": "sentry",
    "name": "Sentry",
    "description": "Sentry 官方 MCP，用于读取 Issue、Trace、性能和调试上下文；建议使用最小权限 token，默认定位为只读诊断。",
    "homepage": "https://github.com/getsentry/sentry-mcp",
    "category": "开发工具",
    "config": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp",
      "headers": {
        "Authorization": "Sentry-Bearer ${SENTRY_ACCESS_TOKEN}"
      }
    },
    "signupUrl": "https://sentry.io/settings/account/api/auth-tokens/"
  },
  {
    "id": "mongodb",
    "name": "MongoDB",
    "description": "MongoDB 官方 MCP，默认只读连接 MongoDB 或 Atlas，适合 schema 理解和查询；写能力需单独确认。",
    "homepage": "https://github.com/mongodb-js/mongodb-mcp-server",
    "category": "文件与数据",
    "config": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server@latest",
        "--readOnly"
      ],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "<YOUR_MONGODB_CONNECTION_STRING>",
        "MDB_MCP_READ_ONLY": "true"
      }
    },
    "signupUrl": "https://www.mongodb.com/products/tools/mcp-server"
  },
  {
    "id": "grafana",
    "name": "Grafana",
    "description": "Grafana Labs 官方 MCP，可查询 dashboard、datasource、告警和观测数据；服务账号 token 应使用最小只读权限。",
    "homepage": "https://github.com/grafana/mcp-grafana",
    "category": "基础设施",
    "config": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "<YOUR_GRAFANA_URL>",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "<YOUR_GRAFANA_SERVICE_ACCOUNT_TOKEN>"
      }
    },
    "signupUrl": "https://grafana.com/docs/grafana/latest/administration/service-accounts/"
  },
  {
    "id": "elasticsearch",
    "name": "Elasticsearch",
    "description": "Elastic 官方 Elasticsearch MCP，建议使用只读 API key 检索和分析集群数据，避免暴露敏感索引或关闭证书校验。",
    "homepage": "https://github.com/elastic/mcp-server-elasticsearch",
    "category": "文件与数据",
    "config": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "ES_URL",
        "-e",
        "ES_API_KEY",
        "docker.elastic.co/mcp/elasticsearch",
        "stdio"
      ],
      "env": {
        "ES_URL": "<YOUR_ELASTICSEARCH_URL>",
        "ES_API_KEY": "<YOUR_ELASTICSEARCH_API_KEY>"
      }
    },
    "signupUrl": "https://www.elastic.co/guide/en/elasticsearch/reference/current/security-api-create-api-key.html"
  },
  {
    "id": "slack",
    "name": "Slack",
    "description": "Slack 官方 MCP，支持搜索、读取线程和协作上下文；发送消息或管理频道前必须确认 OAuth scope 和组织策略。",
    "homepage": "https://docs.slack.dev/ai/slack-mcp-server/",
    "category": "生产力工具",
    "config": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp"
    },
    "signupUrl": "https://api.slack.com/apps"
  },
  {
    "id": "notion",
    "name": "Notion",
    "description": "Notion 官方托管 MCP，按用户授权访问页面、数据库和工作区内容；知识库写入需人工确认。",
    "homepage": "https://developers.notion.com/guides/mcp/overview",
    "category": "生产力工具",
    "config": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "signupUrl": "https://www.notion.so/profile/integrations"
  },
  {
    "id": "linear",
    "name": "Linear",
    "description": "Linear 官方远程 MCP，可查询、创建和更新 issue、project 与 comment；建议通过 OAuth 或只读 token 控制权限。",
    "homepage": "https://linear.app/docs/mcp",
    "category": "生产力工具",
    "config": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      }
    },
    "signupUrl": "https://linear.app/settings/api"
  },
  {
    "id": "brave-search",
    "name": "Brave Search",
    "description": "Brave 官方 Search MCP，提供网页、新闻、图片、视频和本地搜索；建议限制工具范围并注意搜索内容注入风险。",
    "homepage": "https://github.com/brave/brave-search-mcp-server",
    "category": "网络与浏览器",
    "config": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "env": {
        "BRAVE_API_KEY": "<YOUR_BRAVE_API_KEY>",
        "BRAVE_MCP_ENABLED_TOOLS": "web_search,news_search"
      }
    },
    "signupUrl": "https://brave.com/search/api/"
  },
  {
    "id": "atlassian",
    "name": "Atlassian",
    "description": "Atlassian 官方 MCP 入口，面向 Jira、Confluence 和 Forge 开发知识；组织数据写入需 OAuth 授权和人工确认。",
    "homepage": "https://www.atlassian.com/blog/blog/announcements/remote-mcp-server",
    "category": "生产力工具",
    "config": {
      "type": "sse",
      "url": "https://mcp.atlassian.com/v1/sse"
    },
    "signupUrl": "https://developer.atlassian.com/platform/forge/ai-development-toolkit/forge-mcp/"
  }
]
