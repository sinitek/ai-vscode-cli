    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test",
    "test:core": "npm run build && node --test dist/test/loopTaskStore.test.js dist/test/loopTaskStoreCoreCoverage.test.js dist/test/loopMainFailure.test.js dist/test/loopLegacyMigration.test.js dist/test/opencodeCommandRunner.test.js dist/test/commandRunnerCoreBranches.test.js dist/test/commandRunnerCoverage.test.js dist/test/opencodethinkingintegration.test.js dist/test/sessionStoreCoreCoverage.test.js dist/test/sessionLifecycleCoreCoverage.test.js dist/test/promptRuntime.test.js dist/test/promptRuntimeCoreCoverage.test.js dist/test/sessionMessageActions.test.js dist/test/sessionMessageActionsCoreCoverage.test.js dist/test/sessionMessageHandlersCoreCoverage.test.js",
    "test:core-coverage": "npm run build && c8 --all --check-coverage --statements 100 --lines 100 --functions 100 --branches 100 --reports-dir=node_modules/.cache/sinitek-cli-core-coverage --temp-directory=node_modules/.cache/sinitek-cli-core-coverage/tmp --include=dist/loopTaskStore.js --include=dist/loopMainFailure.js --include=dist/cli/commandRunner.js --include=dist/sessionStore.js --include=dist/sessionLifecycle.js --include=dist/sessionMessageActions.js --include=dist/sessionMessageHandlers.js --include=dist/sessionMessageRouter.js --include=dist/promptRuntime.js node --test dist/test/loopTaskStore.test.js dist/test/loopTaskStoreCoreCoverage.test.js dist/test/loopMainFailure.test.js dist/test/loopLegacyMigration.test.js dist/test/opencodeCommandRunner.test.js dist/test/commandRunnerCoreBranches.test.js dist/test/commandRunnerCoverage.test.js dist/test/opencodethinkingintegration.test.js dist/test/sessionStoreCoreCoverage.test.js dist/test/sessionLifecycleCoreCoverage.test.js dist/test/promptRuntime.test.js dist/test/promptRuntimeCoreCoverage.test.js dist/test/sessionMessageActions.test.js dist/test/sessionMessageActionsCoreCoverage.test.js dist/test/sessionMessageHandlersCoreCoverage.test.js",
    "test:page": "npm run build && node --test dist/test/loopmaingroupchatbutton.test.js dist/test/opencodedualmodelwebview.test.js dist/test/multiAgentSettingWebview.test.js dist/test/conversationTabPagination.test.js dist/test/subagentProgress.test.js dist/test/historySessionLoop.test.js dist/test/conversationTabLock.test.js dist/test/openCodeThinkingWebview.test.js dist/test/openCodeTaskListOverlay.test.js dist/test/runPromptHistoryWebview.test.js dist/test/opencodeloopmodewebview.test.js dist/test/loopPromptQueue.test.js dist/test/finalAnswerPolicy.test.js dist/test/traceToolTitleLocalization.test.js dist/test/loopDebatePanel.test.js dist/test/configappcompactcontrols.test.js dist/test/configappcompactlayoutstyles.test.js dist/test/claudeConfigVisualEditor.test.js dist/test/codexConfigVisualEditor.test.js dist/test/opencodeconfigvisualeditor.test.js dist/test/opencodeconfigexample.test.js dist/test/opencodeAutoCommandUi.test.js dist/test/cliPageStaticRenderCoverage.test.js dist/test/clipagescriptruntimecoverage.test.js dist/test/cliPageConfigCoverage.test.js",
    "test:page-coverage": "npm run build && c8 --all --check-coverage --statements 100 --lines 100 --functions 100 --branches 100 --reports-dir=node_modules/.cache/sinitek-cli-page-coverage --temp-directory=node_modules/.cache/sinitek-cli-page-coverage/tmp --include=dist/webview/viewContent.js --include=dist/webview/viewContentHtml.js --include=dist/webview/viewContentI18n.js --include=dist/webview/viewContentScript.js --include=dist/webview/viewProvider.js --include=dist/webview/configPanel.js --include=dist/webview/configProtocol.js --include=dist/webview/configView.js --include=dist/webview/loopDebatePanel.js --include=dist/webview/loopDebatePanelRenderer.js --include=dist/webview/loopDebatePanelStyles.js --include=dist/webview/viewContentScript/attachmentsAndTime.js --include=dist/webview/viewContentScript/coreBootstrap.js --include=dist/webview/viewContentScript/coreRuntimeState.js --include=dist/webview/viewContentScript/eventBindings.js --include=dist/webview/viewContentScript/historyPanels.js --include=dist/webview/viewContentScript/messageRendering.js --include=dist/webview/viewContentScript/modelAndPanelState.js --include=dist/webview/viewContentScript/modelManager.js --include=dist/webview/viewContentScript/runStreamAndQueue.js --include=dist/webview/viewContentScript/settingsAndOverlays.js --include=dist/webview/viewContentScript/taskListAndUi.js --include=dist/webview/viewContentScript/traceRendering.js --include=dist/webview/viewContentScript/windowMessageDispatch.js --include=dist/webview/viewContentStyles.js --include=dist/webview/viewContentStyles/base.js --include=dist/webview/viewContentStyles/chatArea.js --include=dist/webview/viewContentStyles/headerTabs.js --include=dist/webview/viewContentStyles/inputControls.js --include=dist/webview/viewContentStyles/markdown.js --include=dist/webview/viewContentStyles/messages.js --include=dist/webview/viewContentStyles/overlaysModals.js --include=dist/webview/viewContentStyles/systemTrace.js --include=dist/webview/viewContentStyles/tasklist.js --include=dist/webview/viewContentStyles/toastMisc.js --include=dist/webview/viewContentStyles/typingStatus.js node --test dist/test/loopmaingroupchatbutton.test.js dist/test/opencodedualmodelwebview.test.js dist/test/multiAgentSettingWebview.test.js dist/test/conversationTabPagination.test.js dist/test/subagentProgress.test.js dist/test/historySessionLoop.test.js dist/test/conversationTabLock.test.js dist/test/openCodeThinkingWebview.test.js dist/test/openCodeTaskListOverlay.test.js dist/test/runPromptHistoryWebview.test.js dist/test/opencodeloopmodewebview.test.js dist/test/loopPromptQueue.test.js dist/test/finalAnswerPolicy.test.js dist/test/traceToolTitleLocalization.test.js dist/test/loopDebatePanel.test.js dist/test/configappcompactcontrols.test.js dist/test/configappcompactlayoutstyles.test.js dist/test/claudeConfigVisualEditor.test.js dist/test/codexConfigVisualEditor.test.js dist/test/opencodeconfigvisualeditor.test.js dist/test/opencodeconfigexample.test.js dist/test/opencodeAutoCommandUi.test.js dist/test/cliPageStaticRenderCoverage.test.js dist/test/clipagescriptruntimecoverage.test.js dist/test/cliPageConfigCoverage.test.js",
