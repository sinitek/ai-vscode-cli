{
  "$schema": "../ontology.schema.json",
  "version": "1.0.0",
  "as_of": "2026-09-04",
  "domain": {
    "id": "harness-governance",
    "name": "Harness 治理",
    "description": "描述仓库级 AGENTS 规则、skills、执行计划、product specs、记忆、ontology 与 workspace scaffold 如何协同约束 AI 开发任务。",
    "bounded_context": "从任务规则读取、计划记录、技能执行到 scaffold 复用的 AI 协作治理层",
    "status": "active",
    "aliases": ["harness", "AGENTS.md", "skills", "Tasklist", "workspace-scaffold", "ontology", "product specs"],
    "source_refs": [
      {"path": "AGENTS.md"},
      {"path": ".ch/docs/README.md"},
      {"path": ".ch/docs/product-specs/index.md"},
      {"path": ".ch/docs/MEMORY.md"},
      {"path": ".agents/skills/AGENTS.md"}
    ]
  },
  "concepts": [
    {
      "id": "harness.agent_rules",
      "name": "仓库级 AGENTS 规则",
      "kind": "policy",
      "description": "仓库级稳定规则和导航入口，保留项目特有约束与通用 harness 规则，细节下沉到 `.ch/docs/` 或局部 AGENTS。",
      "status": "active",
      "aliases": ["AGENTS.md", "项目规则", "仓库规则"],
      "implementation_paths": ["AGENTS.md"],
      "source_refs": [{"path": "AGENTS.md"}]
    },
    {
      "id": "harness.skill",
      "name": "仓库级 Skill",
      "kind": "capability",
      "description": "仓库内高复用、低噪音的程序性工作流；默认 core 只保留 chromium-playwright-smoke、codegraph、execution-plan、memory-consolidator、memory-indexer、memory-recall、ontology 和 repo-indexer。",
      "status": "active",
      "aliases": ["skills", ".agents/skills", "SKILL.md"],
      "implementation_paths": [".agents/skills"],
      "source_refs": [{"path": ".agents/skills/AGENTS.md"}]
    },
    {
      "id": "harness.execution_plan",
      "name": "执行计划",
      "kind": "ledger",
      "description": "非平凡、多阶段或高风险任务的 working 层记录，承载目标、范围、验收、风险、验证和阶段进展；完成后按 `completed/YYYY-MM/` 月份归档。",
      "status": "active",
      "aliases": ["exec plan", "active plan", "completed/YYYY-MM", "执行计划"],
      "implementation_paths": [".ch/docs/exec-plans"],
      "source_refs": [
        {"path": ".ch/docs/exec-plans/README.md"},
        {"path": ".ch/docs/exec-plans/TEMPLATE.md"}
      ]
    },
    {
      "id": "harness.product_specs",
      "name": "产品规格",
      "kind": "resource",
      "description": "记录系统当前对用户承诺的功能、行为、角色、权限、流程和验收边界；可精简为一个功能总表和少数当前能力分册。",
      "status": "active",
      "aliases": ["product specs", "FEATURE_INVENTORY.md", "功能总表", "当前能力分册"],
      "implementation_paths": [".ch/docs/product-specs"],
      "source_refs": [
        {"path": ".ch/docs/product-specs/index.md"},
        {"path": ".ch/docs/product-specs/FEATURE_INVENTORY.md"}
      ]
    },
    {
      "id": "harness.memory",
      "name": "记忆金字塔",
      "kind": "ledger",
      "description": "把 working、episodic、semantic 和 procedural 信息按 L1-L4 上提、压缩和清理，避免知识长期留在聊天记录。",
      "status": "active",
      "aliases": ["memory", "记忆", "memory-index", "recall"],
      "implementation_paths": [".ch/docs/MEMORY.md", ".ch/docs/memory"],
      "source_refs": [
        {"path": ".ch/docs/MEMORY.md"},
        {"path": ".ch/docs/memory/README.md"}
      ]
    },
    {
      "id": "harness.ontology",
      "name": "AI 开发业务本体",
      "kind": "resource",
      "description": "供 AI 开发任务检索业务概念、关系、规则、跨域场景和事实来源的人工维护语义导航层。",
      "status": "active",
      "aliases": ["ontology", "本体", "业务语义"],
      "implementation_paths": [".ch/docs/ontology", ".agents/skills/ontology"],
      "source_refs": [
        {"path": ".ch/docs/ontology/README.md"},
        {"path": ".agents/skills/ontology/SKILL.md"}
      ]
    },
    {
      "id": "harness.workspace_scaffold",
      "name": "Workspace Scaffold",
      "kind": "resource",
      "description": "插件内置的新工作区 harness 模板，承载通用 AGENTS、必要 skills、轻量 `.ch/docs` 和 ontology 骨架。",
      "status": "active",
      "aliases": ["media/workspace-scaffold", "workspace-scaffold", "scaffold"],
      "implementation_paths": ["media/workspace-scaffold"],
      "source_refs": [
        {"path": "media/workspace-scaffold/AGENTS.md"},
        {"path": ".ch/docs/exec-plans/completed/2026-08/2026-08-22-simplify-workspace-scaffold.md"}
      ]
    }
  ],
  "relations": [
    {
      "id": "harness.relation.rules_govern_skills",
      "name": "AGENTS 规则约束 Skills",
      "description": "仓库级规则定义何时使用 skills、如何记录任务列表和如何同步文档。",
      "status": "active",
      "from": "harness.agent_rules",
      "type": "governs",
      "to": "harness.skill",
      "cardinality": "1:N",
      "source_refs": [{"path": "AGENTS.md", "anchor": "工作方式"}]
    },
    {
      "id": "harness.relation_plan_records_task",
      "name": "执行计划记录任务事实",
      "description": "多阶段或高风险工作先进入 active execution plan，收尾后再归档或上提。",
      "status": "active",
      "from": "harness.execution_plan",
      "type": "records",
      "to": "harness.memory",
      "cardinality": "N:N",
      "source_refs": [{"path": ".ch/docs/MEMORY.md", "anchor": "当前任务事实"}]
    },
    {
      "id": "harness.relation.ontology_references_sources",
      "name": "Ontology 引导事实来源核对",
      "description": "ontology 只做语义导航，命中后仍需打开 source_refs 指向的事实来源核对。",
      "status": "active",
      "from": "harness.ontology",
      "type": "references",
      "to": "harness.agent_rules",
      "cardinality": "N:N",
      "source_refs": [{"path": ".ch/docs/ontology/README.md", "anchor": "边界"}]
    },
    {
      "id": "harness.relation.ontology_references_product_specs",
      "name": "Ontology 引导产品规格核对",
      "description": "ontology 可说明概念关系并指向 product specs；涉及当前用户承诺时必须回到产品规格核对。",
      "status": "active",
      "from": "harness.ontology",
      "type": "references",
      "to": "harness.product_specs",
      "cardinality": "N:N",
      "source_refs": [{"path": ".ch/docs/product-specs/index.md", "anchor": "与 ontology、计划和记忆热区的边界"}]
    },
    {
      "id": "harness.relation.scaffold_materializes_harness",
      "name": "Scaffold 物化 Harness 骨架",
      "description": "workspace scaffold 把 AGENTS、必要 skills、轻量 `.ch/docs` 和 ontology 骨架复制到新工作区。",
      "status": "active",
      "from": "harness.workspace_scaffold",
      "type": "materializes",
      "to": "harness.agent_rules",
      "cardinality": "1:N",
      "source_refs": [
        {"path": "media/workspace-scaffold/AGENTS.md"},
        {"path": ".ch/docs/exec-plans/completed/2026-08/2026-08-22-simplify-workspace-scaffold.md"}
      ]
    }
  ],
  "rules": [
    {
      "id": "harness.rule.tasklist_format",
      "name": "Tasklist 格式固定",
      "description": "非平凡任务状态更新使用 `Tasklist:` 标题和 `[pending]`、`[in_progress]`、`[completed]` 状态，任务描述使用中文。",
      "aliases": ["任务列表", "Tasklist"],
      "status": "active",
      "applies_to": ["harness.agent_rules", "harness.execution_plan"],
      "source_refs": [{"path": "AGENTS.md", "anchor": "工作方式"}]
    },
    {
      "id": "harness.rule.core_skill_set",
      "name": "Core Skills 精简集合",
      "description": "仓库级 core skills 默认只保留必要、高复用、低噪音的八个入口；治理报表、跨仓导入导出、评测、工作台 UI 和协作看板不随 core skeleton 提供。",
      "aliases": ["core skills", "轻量技能集合", "技能精简"],
      "status": "active",
      "applies_to": ["harness.skill", "harness.workspace_scaffold"],
      "source_refs": [
        {"path": ".agents/skills/AGENTS.md"},
        {"path": ".ch/docs/README.md", "anchor": "快速入口"}
      ]
    },
    {
      "id": "harness.rule.ontology_source_first",
      "name": "Ontology 不替代事实来源",
      "description": "ontology 命中后必须继续打开 source_refs 指向的产品规格、架构、SQL 或代码核对；冲突时以事实来源为准。",
      "status": "active",
      "applies_to": ["harness.ontology"],
      "source_refs": [{"path": ".ch/docs/ontology/README.md", "anchor": "边界"}]
    },
    {
      "id": "harness.rule.product_specs_commitment_source",
      "name": "Product Specs 记录当前用户承诺",
      "description": "product specs 可以保持精简，但系统当前对用户承诺的功能、行为、权限、流程或验收变化必须回到功能总表或当前能力分册，不能只留在 ontology、memory 或执行计划。",
      "aliases": ["功能总表", "当前能力分册", "用户承诺"],
      "status": "active",
      "applies_to": ["harness.product_specs", "harness.ontology", "harness.execution_plan", "harness.memory"],
      "source_refs": [
        {"path": ".ch/docs/product-specs/index.md", "anchor": "与 ontology、计划和记忆热区的边界"},
        {"path": ".ch/docs/README.md", "anchor": "维护原则"}
      ]
    },
    {
      "id": "harness.rule.exec_plan_monthly_archive",
      "name": "执行计划按月归档",
      "description": "完成计划归档到 `.ch/docs/exec-plans/completed/YYYY-MM/`，不得平铺在 `completed/` 根目录；枚举历史计划时递归扫描 `completed/**/*.md` 并保留完整相对路径。",
      "aliases": ["completed/YYYY-MM", "月份归档", "completed/**/*.md"],
      "status": "active",
      "applies_to": ["harness.execution_plan", "harness.skill"],
      "source_refs": [
        {"path": ".ch/docs/exec-plans/README.md", "anchor": "命名建议"},
        {"path": ".ch/docs/exec-plans/completed/2026-08/2026-08-13-exec-plan-monthly-archive-support.md"}
      ]
    },
    {
      "id": "harness.rule.ontology_bootstrap_required",
      "name": "空本体先初始化",
      "description": "AI 执行业务语义相关任务前必须先运行 ontology `--status-report`；本体为空、缺少非 harness 业务 domain 或仍是 scaffold `project.*` 占位时，先根据项目已有事实源初始化 ontology，再继续实现。",
      "aliases": ["空本体", "ontology 初始化", "project.* 占位", "--status-report"],
      "status": "active",
      "applies_to": ["harness.ontology", "harness.agent_rules", "harness.skill"],
      "source_refs": [
        {"path": "AGENTS.md", "anchor": "AI 开发业务本体（Ontology）"},
        {"path": ".agents/skills/ontology/SKILL.md", "anchor": "空本体初始化流程"},
        {"path": ".ch/docs/ontology/README.md", "anchor": "任务中的使用顺序"}
      ]
    },
    {
      "id": "harness.rule.scaffold_business_neutral",
      "name": "Scaffold 保持业务中性",
      "description": "内置 workspace scaffold 只承载通用 harness 和空白/示例 ontology 结构，不植入来源仓库的业务专属概念。",
      "status": "active",
      "applies_to": ["harness.workspace_scaffold", "harness.ontology"],
      "source_refs": [{"path": ".ch/docs/exec-plans/completed/2026-08/2026-08-13-harness-ontology-scaffold-sync.md"}]
    }
  ]
}
