{
  "$schema": "../ontology.schema.json",
  "version": "1.0.0",
  "as_of": "2026-08-25",
  "domain": {
    "id": "cli-plugin-runtime",
    "name": "VS Code CLI 插件运行时",
    "description": "描述插件如何在 VS Code 中承载 AI 对话面板、调用本地 CLI、管理会话和配置，并编排 Loop/Graph 等执行模式。",
    "bounded_context": "VS Code 扩展入口到本地 CLI 执行、会话状态和用户可见结果的运行链路",
    "status": "active",
    "aliases": ["VS Code 插件", "CLI 插件", "AI 对话", "本地 CLI", "Loop", "Graph"],
    "source_refs": [
      {"path": "ARCHITECTURE.md"},
      {"path": ".ch/docs/product-specs/sinitek-cli-plugin-capabilities.md"},
      {"path": ".ch/docs/references/cli-runtime-reference.md"}
    ]
  },
  "concepts": [
    {
      "id": "plugin.extension_host",
      "name": "扩展宿主运行时",
      "kind": "aggregate",
      "description": "VS Code 扩展入口和 host 组合根，注册命令、装配运行时服务，并把 Webview、CLI、会话和本地状态连接起来。",
      "status": "active",
      "aliases": ["extension host", "extension.ts", "组合根"],
      "implementation_paths": ["src/extension.ts", "src/extensionHost"],
      "source_refs": [{"path": "ARCHITECTURE.md", "anchor": "扩展编排层"}]
    },
    {
      "id": "plugin.chat_panel",
      "name": "AI 对话面板",
      "kind": "capability",
      "description": "VS Code 内的用户交互入口，展示多 CLI 对话、运行状态、配置入口和不同执行模式的可见反馈。",
      "status": "active",
      "aliases": ["Webview", "聊天面板", "panel", "config panel"],
      "implementation_paths": ["src/webview", "media/config/assets"],
      "source_refs": [
        {"path": "README.md", "anchor": "功能概览"},
        {"path": "ARCHITECTURE.md", "anchor": "Webview/UI 层"}
      ]
    },
    {
      "id": "plugin.local_cli",
      "name": "本地 AI CLI",
      "kind": "resource",
      "description": "插件调用的本地命令行 AI 工具，包括 Codex、Claude 和 OpenCode；命令、参数、会话和输出解析由服务层处理。",
      "status": "active",
      "aliases": ["codex", "claude", "opencode", "local CLI"],
      "implementation_paths": ["src/cli", "src/interactive"],
      "source_refs": [
        {"path": ".ch/docs/references/cli-runtime-reference.md"},
        {"path": "docs/cli-reference.md"}
      ]
    },
    {
      "id": "plugin.cli_session",
      "name": "CLI 会话状态",
      "kind": "aggregate",
      "description": "对话 Tab 与底层 CLI session/thread 的映射，承载续接、停止、恢复、消息持久化和跨运行时生命周期适配；Codex 模型或配置档案切换仍优先续接已映射 thread，并由当前配置提供 modelProvider。",
      "status": "active",
      "aliases": ["session", "thread", "tab", "会话续接"],
      "implementation_paths": ["src/sessionTabs.ts", "src/interactive"],
      "source_refs": [
        {"path": "ARCHITECTURE.md", "anchor": "CLI / Interactive / Config 服务层"},
        {"path": ".ch/docs/design-docs/vscode-cli-extension-runtime.md"}
      ]
    },
    {
      "id": "plugin.config_profile",
      "name": "CLI 配置档案",
      "kind": "configuration",
      "description": "插件管理 Codex、Claude、OpenCode 等本地配置、Skills、MCP 和模型/思考力度设置的编辑与持久化边界。",
      "status": "active",
      "aliases": ["配置中心", "profile", "MCP", "Skills"],
      "implementation_paths": ["src/config", "media/config/assets"],
      "source_refs": [
        {"path": ".ch/docs/product-specs/sinitek-cli-plugin-capabilities.md"},
        {"path": "ARCHITECTURE.md", "anchor": "CLI / Interactive / Config 服务层"}
      ]
    },
    {
      "id": "plugin.loop_task",
      "name": "Loop 任务",
      "kind": "aggregate",
      "description": "插件内的多智能体/多轮任务编排记录，包含主任务、子任务、群聊沟通文件、状态恢复和本地持久化。子任务局部中断或失败不会终止仍为 running 的父任务；父任务在所有 activeSubtaskIds 对应子任务完成后才可继续复核，用户从群聊或主任务 Tab 发起停止时仍统一停止父子任务；缺失或未知持久化 status 不得恢复为 running。",
      "status": "active",
      "aliases": ["Loop", "loop task", "多智能体", "群聊"],
      "implementation_paths": ["src/loopTaskStore.ts", "src/loopDebate.ts", "src/loopSubtaskExecutionRoot.ts", "src/loopSubtaskLifecycle.ts", "src/extensionHost/loopOrchestration.ts", "src/extensionHost/promptRunRuntime.ts", "src/extension.ts", "src/webview/viewContentScript/messageRendering.ts"],
      "source_refs": [
        {"path": "ARCHITECTURE.md", "anchor": "Loop 子任务执行隔离"},
        {"path": ".ch/docs/product-specs/sinitek-cli-plugin-capabilities.md"}
      ]
    },
    {
      "id": "plugin.graph_run",
      "name": "Graph 运行图",
      "kind": "aggregate",
      "description": "插件中的可视化 DAG 执行模式，负责任务规划、节点调度、可视化状态、证据和续跑控制。",
      "status": "active",
      "aliases": ["Graph", "DAG", "运行图"],
      "implementation_paths": ["src/graph"],
      "source_refs": [
        {"path": ".ch/docs/design-docs/graph-orchestration-mode.md"},
        {"path": ".ch/docs/product-specs/sinitek-cli-plugin-capabilities.md"}
      ]
    }
  ],
  "relations": [
    {
      "id": "plugin.relation.host_contains_panel",
      "name": "扩展宿主承载对话面板",
      "description": "扩展宿主注册命令和视图，并为 Webview 注入状态与消息处理链路。",
      "status": "active",
      "from": "plugin.extension_host",
      "type": "contains",
      "to": "plugin.chat_panel",
      "cardinality": "1:N",
      "source_refs": [{"path": "ARCHITECTURE.md", "anchor": "推荐依赖方向"}]
    },
    {
      "id": "plugin.relation.panel_uses_cli",
      "name": "对话面板使用本地 CLI",
      "description": "用户在对话面板发起请求后，由扩展宿主和服务层选择对应本地 CLI 执行。",
      "status": "active",
      "from": "plugin.chat_panel",
      "type": "uses",
      "to": "plugin.local_cli",
      "cardinality": "N:N",
      "source_refs": [{"path": "README.md", "anchor": "适用场景"}]
    },
    {
      "id": "plugin.relation.cli_produces_session",
      "name": "本地 CLI 产生会话状态",
      "description": "交互式或一次性 CLI 运行会更新会话、Tab 和消息状态，用于续接与恢复。",
      "status": "active",
      "from": "plugin.local_cli",
      "type": "produces",
      "to": "plugin.cli_session",
      "cardinality": "N:N",
      "source_refs": [{"path": ".ch/docs/references/cli-runtime-reference.md"}]
    },
    {
      "id": "plugin.relation.config_governs_cli",
      "name": "配置档案约束 CLI 执行",
      "description": "CLI 命令、参数、模型、思考力度、Skills 和 MCP 候选由配置档案与工具设置共同约束；Codex 当前配置的根级 model_provider 还约束 app-server thread start/resume 的 provider。",
      "status": "active",
      "from": "plugin.config_profile",
      "type": "governs",
      "to": "plugin.local_cli",
      "cardinality": "N:N",
      "source_refs": [{"path": ".ch/docs/product-specs/sinitek-cli-plugin-capabilities.md"}]
    },
    {
      "id": "plugin.relation.loop_executes_cli",
      "name": "Loop 任务执行本地 CLI",
      "description": "Loop 主任务和子任务通过对应 CLI 路由执行，并将状态写入本地任务存储。",
      "status": "active",
      "from": "plugin.loop_task",
      "type": "executes",
      "to": "plugin.local_cli",
      "cardinality": "N:N",
      "source_refs": [{"path": "ARCHITECTURE.md", "anchor": "Loop 子任务执行隔离"}]
    },
    {
      "id": "plugin.relation.graph_executes_cli",
      "name": "Graph 节点执行本地 CLI",
      "description": "Graph planner、执行节点和 summary 节点通过模型路由选择 CLI 角色并记录节点证据。",
      "status": "active",
      "from": "plugin.graph_run",
      "type": "executes",
      "to": "plugin.local_cli",
      "cardinality": "N:N",
      "source_refs": [{"path": ".ch/docs/design-docs/graph-orchestration-mode.md"}]
    }
  ],
  "rules": [
    {
      "id": "plugin.rule.webview_no_direct_fs",
      "name": "Webview 不直接访问文件系统或 CLI",
      "description": "Webview/UI 层只负责渲染和协议消息，不直接拼接文件系统或 CLI 调用逻辑。",
      "status": "active",
      "applies_to": ["plugin.chat_panel", "plugin.local_cli"],
      "source_refs": [{"path": "ARCHITECTURE.md", "anchor": "明确禁止"}]
    },
    {
      "id": "plugin.rule.i18n_required",
      "name": "新增修改功能必须支持国际化",
      "description": "本插件支持中英文；新增或修改用户可见功能时必须同步处理国际化文案。",
      "status": "active",
      "applies_to": ["plugin.chat_panel"],
      "source_refs": [{"path": "AGENTS.md", "anchor": "开发注意事项"}]
    },
    {
      "id": "plugin.rule.cli_child_lifecycle_guarded",
      "name": "CLI 子进程必须完整跟踪并清理",
      "description": "本地 CLI 运行时必须跟踪所有活跃子进程；Codex app-server 等会派生后代进程的运行应使用独立进程组并在停止、取消、扩展停用和 spawn error 时收口 promise、pipe 和进程组，避免残留资源导致 EAGAIN。",
      "status": "active",
      "applies_to": ["plugin.local_cli", "plugin.cli_session", "plugin.loop_task", "plugin.graph_run"],
      "source_refs": [
        {"path": ".ch/docs/references/cli-runtime-reference.md"},
        {"path": ".ch/docs/runbooks/PITFALLS.md", "anchor": "Codex app-server 残留进程会把 spawn 失败放大成 EAGAIN"}
      ]
    },
    {
      "id": "plugin.rule.local_state_boundary",
      "name": "本地状态边界明确",
      "description": "运行时状态、Loop 任务和外部 CLI 配置属于本地资源层，不应混入 UI 组件或业务编排细节。",
      "status": "active",
      "applies_to": ["plugin.cli_session", "plugin.loop_task", "plugin.config_profile"],
      "source_refs": [{"path": "ARCHITECTURE.md", "anchor": "基础本地资源层"}]
    },
    {
      "id": "plugin.rule.loop_subtask_interruption_isolated",
      "name": "Loop 子任务中断与父任务状态隔离",
      "description": "单个子任务停止或失败时只保留该子任务为待续跑状态，父任务继续保持 running 并等待 activeSubtaskIds 清空；只要父任务仍为 running，主任务 Tab 即使没有直接 CLI 进程也可发起停止。全部活动子任务成功完成后才可唤醒主任务复核；用户从 Loop 群聊或主任务 Tab 停止整个任务时，父任务和活动子任务统一进入 stopped。",
      "status": "active",
      "applies_to": ["plugin.loop_task"],
      "source_refs": [
        {"path": ".ch/docs/product-specs/sinitek-cli-plugin-capabilities.md"},
        {"path": ".ch/docs/references/cli-runtime-reference.md"}
      ]
    },
    {
      "id": "plugin.rule.opencode_model_selection_scoped_to_config",
      "name": "OpenCode 模型选择必须绑定配置档案",
      "description": "AI 对话面板更新 OpenCode 主/子角色模型时必须携带当前 configId；扩展宿主优先按该配置 ID 校验和写入。Webview 在同一配置尚未回显有效模型引用前保留待确认选择，异步旧快照不得覆盖用户刚完成的选择。",
      "status": "active",
      "applies_to": ["plugin.chat_panel", "plugin.config_profile", "plugin.local_cli"],
      "source_refs": [
        {"path": "src/webview/viewContentScript/eventBindings.ts", "anchor": "handleOpenCodeRoleModelChange"},
        {"path": "src/webview/viewContentScript/modelAndPanelState.ts", "anchor": "reconcilePendingOpenCodeRoleSelection"},
        {"path": "src/sessionMessageHandlers.ts", "anchor": "handlePanelMessageWithDeps"},
        {"path": ".ch/docs/runbooks/PITFALLS.md", "anchor": "OpenCode 模型选择消息必须绑定配置 ID"}
      ]
    }
  ]
}
